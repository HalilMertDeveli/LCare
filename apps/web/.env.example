# Base URL of the LEDCare OS API (ASP.NET Core). Server-side only: used by the
# Next.js rewrites that proxy /api/* and /hubs/* to keep the session cookie first-party.
LEDCARE_API_URL=http://localhost:5080

# E2E tests (Playwright) only: base URL of the web app under test. If unset, Playwright
# starts `next dev` on port 3000 itself.
# E2E_BASE_URL=http://localhost:3000
